{
  "extends": "../tsconfig.base.json",
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "vitest.config.ts", "vitest.conformance.config.ts"],
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "types": ["node"]
  }
}
