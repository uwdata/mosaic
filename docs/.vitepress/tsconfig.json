{
  "include": [
    "config.ts",
    "theme/*.ts",
    "theme/*.vue",
    "../../vite.config.js"
  ],
  "compilerOptions": {
    // Adapted from https://github.com/vuejs/tsconfig/blob/dc7af0b6a1e8a66239950a65423c5456ef5ba739/tsconfig.json
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "libReplacement": false,
    "strict": true,
    // Duplicated from (../../tsconfig.base.json) 
    // to avoid 'Unrecognized target environment "es2024"'
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
  },
}